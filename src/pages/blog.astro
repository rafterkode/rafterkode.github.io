---
import Layout from '../layouts/Layout.astro';

const articles = [
	{
		title: "mypdfrag: Local PDF RAG with Ollama and ChromaDB",
		description: "Query sensitive documents without sending them to any external API. A fully local RAG pipeline built with Python, Ollama, ChromaDB and FastAPI. Runs on 8GB RAM, no GPU required.",
		category: "AI",
		date: "22 November 2026",
		readTime: "5 min",
		href: "https://github.com/rafterkode/mypdfrag",
		tags: ["RAG", "LLM", "Ollama", "ChromaDB", "Privacy", "Open Source"]
	},
	{
		title: "n8n + AI: Building Production Workflows with Cloud LLMs",
		description: "How to wire OpenAI, Claude, or Gemini into n8n for lead scoring, document processing, and multi-agent content pipelines. Self-hosted, cost-optimized, and API-key managed.",
		category: "Automation",
		date: "18 November 2026",
		readTime: "10 min",
		href: "https://dev.to/rafterkode/n8n-ai-production-workflows",
		tags: ["n8n", "Automation", "OpenAI", "Claude", "Workflows"]
	},
	{
		title: "Local vs Cloud AI: When to Use What",
		description: "A pragmatic framework for deciding whether your AI workload should stay on-prem or hit an external API. Cost, latency, compliance, and quality trade-offs explained.",
		category: "AI",
		date: "10 November 2026",
		readTime: "8 min",
		href: "https://dev.to/rafterkode/local-vs-cloud-ai",
		tags: ["AI", "Architecture", "Privacy", "Cloud", "Decision Framework"]
	},
	{
		title: "DevSecOps Guide 2024: Securing Your CI/CD Pipeline",
		description: "Integrate security from the earliest stages of development with a modern DevSecOps approach. SAST, DAST, secret scanning, and image signing in one pipeline.",
		category: "DevSecOps",
		date: "15 January 2024",
		readTime: "12 min",
		href: "/blog/devsecops-guide",
		tags: ["DevSecOps", "CI/CD", "Security", "Docker"]
	},
	{
		title: "WordPress Performance: Advanced Optimization",
		description: "Modern techniques to speed up your WordPress site and improve Core Web Vitals scores.",
		category: "WordPress",
		date: "10 January 2024",
		readTime: "8 min",
		href: "#",
		tags: ["WordPress", "Performance", "Optimization", "Core Web Vitals"]
	},
	{
		title: "SaaS Architecture: Patterns and Best Practices",
		description: "Build a scalable architecture for your SaaS application with modern cloud technologies.",
		category: "SaaS",
		date: "28 December 2023",
		readTime: "10 min",
		href: "#",
		tags: ["SaaS", "Architecture", "Cloud", "Scalability"]
	}
];

const categories = ["All", "AI", "Automation", "DevSecOps", "WordPress", "SaaS"];
---

<Layout
	title="Articles - RafterKode"
	description="Technical articles on AI infrastructure, workflow automation, DevSecOps, and modern web development. Practical guides and hands-on experience."
>
	<main class="blog-page">
		<div class="container">
			<a href="/" class="back-link">
				<i data-lucide="arrow-left"></i>
				Back to Home
			</a>

			<header class="blog-header">
				<h1 class="blog-title gradient-text">Technical Articles</h1>
				<p class="blog-description">
					Practical guides on AI infrastructure, workflow automation,
					and secure development. Written from production experience.
				</p>
			</header>

			<div class="blog-filters">
				{categories.map((category) => (
					<button class={`filter-btn ${category === 'All' ? 'active' : ''}`}>
						{category}
					</button>
				))}
			</div>

			<div class="articles-grid">
				{articles.map((article) => (
					<article class="article-card card">
						<div class="article-header">
							<div class="article-meta">
								<span class="category">{article.category}</span>
								<time class="date">{article.date}</time>
							</div>
							<span class="read-time">{article.readTime}</span>
						</div>

						<h2 class="article-title">
							<a href={article.href}>{article.title}</a>
						</h2>

						<p class="article-description">{article.description}</p>

						<div class="article-tags">
							{article.tags.map((tag) => (
								<span class="tag">{tag}</span>
							))}
						</div>

						<div class="article-footer">
							<a href={article.href} class="read-more">
								Read more
								<i data-lucide="arrow-right"></i>
							</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</main>
</Layout>

<style>
	.blog-page {
		padding: 2rem 0 4rem;
		min-height: 100vh;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: hsl(var(--foreground) / 0.7);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		margin-bottom: 2rem;
		transition: color 0.3s ease;
	}

	.back-link:hover {
		color: hsl(var(--primary));
	}

	.back-link i {
		width: 16px;
		height: 16px;
	}

	.blog-header {
		text-align: center;
		margin-bottom: 3rem;
	}

	.blog-title {
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 700;
		margin-bottom: 1rem;
	}

	.blog-description {
		font-size: 1.125rem;
		color: hsl(var(--foreground) / 0.8);
		max-width: 600px;
		margin: 0 auto;
		line-height: 1.6;
	}

	.blog-filters {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 3rem;
		flex-wrap: wrap;
	}

	.filter-btn {
		padding: 0.5rem 1rem;
		background: hsl(var(--muted));
		border: 1px solid hsl(var(--border));
		border-radius: 1.5rem;
		color: hsl(var(--foreground) / 0.8);
		font-size: 0.875rem;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.filter-btn:hover,
	.filter-btn.active {
		background: var(--gradient-primary);
		color: white;
		border-color: transparent;
	}

	.articles-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2rem;
	}

	.article-card {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.article-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 1rem;
		gap: 1rem;
	}

	.article-meta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.category {
		background: var(--gradient-primary);
		color: white;
		padding: 0.25rem 0.75rem;
		border-radius: 1rem;
		font-size: 0.75rem;
		font-weight: 500;
		width: fit-content;
	}

	.date {
		color: hsl(var(--foreground) / 0.7);
		font-size: 0.875rem;
	}

	.read-time {
		color: hsl(var(--foreground) / 0.7);
		font-size: 0.875rem;
		white-space: nowrap;
	}

	.article-title {
		margin-bottom: 1rem;
	}

	.article-title a {
		color: hsl(var(--foreground));
		text-decoration: none;
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1.4;
		transition: color 0.3s ease;
	}

	.article-title a:hover {
		color: hsl(var(--primary));
	}

	.article-description {
		color: hsl(var(--foreground) / 0.8);
		line-height: 1.6;
		margin-bottom: 1.5rem;
		flex-grow: 1;
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}

	.tag {
		padding: 0.25rem 0.75rem;
		background: hsl(var(--muted));
		border: 1px solid hsl(var(--border));
		border-radius: 1rem;
		font-size: 0.75rem;
		color: hsl(var(--foreground) / 0.8);
	}

	.article-footer {
		margin-top: auto;
	}

	.read-more {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: hsl(var(--primary));
		text-decoration: none;
		font-weight: 500;
		transition: all 0.3s ease;
	}

	.read-more:hover {
		gap: 0.75rem;
	}

	.read-more i {
		width: 16px;
		height: 16px;
		transition: transform 0.3s ease;
	}

	.read-more:hover i {
		transform: translateX(2px);
	}

	@media (max-width: 768px) {
		.articles-grid {
			grid-template-columns: 1fr;
		}

		.blog-filters {
			justify-content: flex-start;
			overflow-x: auto;
			padding-bottom: 0.5rem;
		}

		.filter-btn {
			white-space: nowrap;
		}
	}
</style>   