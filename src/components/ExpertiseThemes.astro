---
// components/ExpertiseThemes.astro

const themes = [
	{
		icon: "shield",
		title: "Privacy-First AI",
		description: "Local RAG pipelines that keep your documents on your hardware. No data leaves your machine. Built for legal, medical, and sensitive corporate use cases."
	},
	{
		icon: "workflow",
		title: "AI-Powered Automation",
		description: "n8n workflows connecting cloud LLMs (OpenAI, Claude, Gemini) to your CRM, email, and internal tools. Production-grade, self-hosted, API-cost aware."
	},
	{
		icon: "server",
		title: "Secure Infrastructure",
		description: "Hardened servers, CI/CD pipelines, and hybrid cloud/on-prem architectures. The foundation that makes both AI approaches reliable and auditable."
	}
];
---

<section class="expertise">
	<div class="container">
		<h2 class="section-title">What I do</h2>
		<div class="expertise-grid">
			{themes.map((theme) => (
				<div class="expertise-card card">
					<div class="expertise-icon">
						<i data-lucide={theme.icon}></i>
					</div>
					<h3>{theme.title}</h3>
					<p>{theme.description}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.expertise {
		padding: 4rem 0;
	}

	.section-title {
		text-align: center;
		font-size: 2rem;
		margin-bottom: 3rem;
	}

	.expertise-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.expertise-card {
		padding: 2rem;
		text-align: center;
	}

	.expertise-icon {
		width: 48px;
		height: 48px;
		margin: 0 auto 1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--gradient-primary);
		border-radius: 0.75rem;
		color: white;
	}

	.expertise-card h3 {
		margin-bottom: 0.75rem;
		font-size: 1.15rem;
	}

	.expertise-card p {
		color: hsl(var(--foreground) / 0.8);
		font-size: 0.95rem;
		line-height: 1.6;
	}
</style>   