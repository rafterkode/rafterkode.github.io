---
// components/Portfolio.astro

const projects = [
	{
		title: "mypdfrag",
		description: "Local-first PDF RAG engine. Query sensitive documents without sending them to any external API. Built with Ollama, ChromaDB, and FastAPI. Runs on 8GB RAM, no GPU.",
		tags: ["RAG", "Ollama", "ChromaDB", "FastAPI", "Privacy"],
		link: "https://github.com/rafterkode/mypdfrag",
		commercial: true,
		commercialLink: "LIEN_GUMROAD"
	},
	{
		title: "n8n AI Automation Suite",
		description: "Production n8n workflows: AI lead scoring, document processing pipelines, multi-agent content generation, and CRM sync. Self-hosted, cost-optimized, API-key managed.",
		tags: ["n8n", "OpenAI", "Claude", "Automation", "CRM"],
		link: "#",
		commercial: false
	},
	{
		title: "DevSecOps Pipeline Templates",
		description: "Hardened CI/CD pipelines with SAST, DAST, secret scanning, and container image signing. Ready-to-deploy for GitLab and GitHub Actions.",
		tags: ["DevSecOps", "CI/CD", "Docker", "Compliance"],
		link: "/blog/devsecops-guide",
		commercial: false
	}
];
---

<section class="portfolio">
	<div class="container">
		<h2 class="section-title">Projects</h2>
		<div class="portfolio-grid">
			{projects.map((project) => (
				<div class="project-card card">
					<div class="project-header">
						<h3>
							<a href={project.link}>{project.title}</a>
						</h3>
						{project.commercial && (
							<span class="badge-commercial">
								<a href={project.commercialLink}>Commercial version →</a>
							</span>
						)}
					</div>
					<p>{project.description}</p>
					<div class="project-tags">
						{project.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
					<a href={project.link} class="project-link">
						View project <i data-lucide="external-link"></i>
					</a>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.portfolio {
		padding: 4rem 0;
	}

	.section-title {
		text-align: center;
		font-size: 2rem;
		margin-bottom: 3rem;
	}

	.portfolio-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2rem;
	}

	.project-card {
		padding: 2rem;
		display: flex;
		flex-direction: column;
	}

	.project-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 1rem;
		gap: 0.5rem;
	}

	.project-header h3 a {
		color: hsl(var(--foreground));
		text-decoration: none;
		font-size: 1.2rem;
		transition: color 0.3s;
	}

	.project-header h3 a:hover {
		color: hsl(var(--primary));
	}

	.badge-commercial a {
		font-size: 0.75rem;
		color: hsl(var(--primary));
		text-decoration: none;
		font-weight: 500;
		white-space: nowrap;
	}

	.badge-commercial a:hover {
		text-decoration: underline;
	}

	.project-card p {
		color: hsl(var(--foreground) / 0.8);
		font-size: 0.95rem;
		line-height: 1.6;
		margin-bottom: 1.5rem;
		flex-grow: 1;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}

	.tag {
		padding: 0.25rem 0.75rem;
		background: hsl(var(--muted));
		border: 1px solid hsl(var(--border));
		border-radius: 1rem;
		font-size: 0.75rem;
		color: hsl(var(--foreground) / 0.8);
	}

	.project-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: hsl(var(--primary));
		text-decoration: none;
		font-weight: 500;
		font-size: 0.9rem;
	}

	.project-link:hover {
		gap: 0.6rem;
	}

	.project-link i {
		width: 14px;
		height: 14px;
	}
</style>   